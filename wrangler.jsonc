{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "washy-washy-web",
  "compatibility_date": "2026-08-22",
  // No Worker script: this is a static site, served entirely from the
  // Astro build's output. Static-only Workers still need a
  // compatibility_date, but nothing here ever runs server-side code.
  "assets": {
    "directory": "./dist",
    // Serve the nearest 404.html, with a 404 status, for a path that matches
    // no file. Without it Cloudflare answers with its own plain-text 404.
    "not_found_handling": "404-page"
  }
}
