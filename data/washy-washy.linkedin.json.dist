    {
      "clothing_type": "Microfibre Towels (Niche Vertical)",
      "detergent": "Liquid detergent, half dose. Whatever doesn't rinse clean stays trapped in the split fibre and tanks its pickup rate.",
      "fabric_softener": "no",
      "temperature": "40",
      "spin": "1200",
      "duration": "~1:30",
      "program": "Low-Lift",
      "options": "Extra Diligence",
      "ironing": "no",
      "ironing_notes": "Polyester and polyamide start melting around 110 °C — well before alignment adds any value. Skip it.",
      "iron_setting": "",
      "drying": "Air dry, or tumble on low. High heat fuses the split ends shut and the towel's absorbency never recovers — a permanent regression.",
      "colour_group": "colour",
      "mix_tags": "lint-magnet",
      "notes": "Never the softener culture-add — fills the split fibres with silicone and the towel is done, full stop. Wash with microfibre only: the same split ends that drive its absorbency also grab cotton lint and never let go — a genuine architectural constraint.",
      "reference_name": "",
      "reference_link": ""
    },
    {
      "clothing_type": "Darks (Understated but Essential)",
      "detergent": "Liquid detergent for dark/black — optical brighteners are exactly what leaves that grey haze, a classic vanity-metric trap",
