      "temperature": "30",
      "spin": "800",
      "duration": "~2:00",
      "program": "Cottons",
      "options": "Extra Diligence",
      "ironing": "yes",
      "ironing_notes": "Inside out, medium heat. Steam, don't press hard — shine on dark cotton is a permanent regression, unrecoverable.",
      "iron_setting": "2",
      "drying": "Line dry inside out, out of direct sun. Skip the dryer — heat fades black fastest of any cohort.",
      "colour_group": "dark",
      "mix_tags": "dye-bleeder",
      "notes": "Turn everything inside out. The extra diligence matters most here — residue dries as grey streaks, and that's a brand-safety issue.",
      "reference_name": "",
      "reference_link": ""
    },
