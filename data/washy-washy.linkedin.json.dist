{
  "$schema": "https://cdn.jsdelivr.net/npm/@washy-washy/core/schema/config.schema.json",
  "machine": {
    "washer": {
      "name": "Generic Front-Loading Growth Engine",
      "capacity": "1–8 kg of untapped potential",
      "programs": [
        "Off the Clock",
        "Cottons",
        "Cottons + Pre-Sprint",
        "Low-Lift",
        "Low-Lift + Pre-Sprint",
        "Quick Win",
        "High-Touch / Silk",
        "Wool (Premium Tier)",
        "Rinse / Pivot",
        "Drain & Reset",
        "Soft Launch",
        "MVP 15'",
        "Low-Lift Special",
        "Handle With Care",
        "Hustle Mode",
        "Wellness Initiative"
      ],
      "temperatures": ["cold", "20", "30", "40", "60", "90"],
      "spins": ["0", "400", "600", "800", "1200", "1400"],
      "options": ["Fast-Track", "Sustainability Flex", "Low-Effort Alignment", "Extra Diligence"]
    },
    "iron": {
      "name": "Generic Steam-Powered Alignment Tool",
      "settings": [
        {
          "key": "min",
          "dots": "",
          "label": "MIN",
          "detail": "no heat — pure potential energy",
          "steam": false
        },
        {
          "key": "1",
          "dots": "•",
          "label": "•",
          "detail": "synthetics · 110 °C (fast-track tier)",
          "steam": false
        },
        {
          "key": "2",
          "dots": "••",
          "label": "••",
          "detail": "wool, silk · 150 °C (premium tier)",
          "steam": true
        },
        {
          "key": "3",
          "dots": "•••",
          "label": "•••",
          "detail": "cotton, linen · 200 °C (core deliverable tier)",
          "steam": true
        },
        {
          "key": "max",
          "dots": "•••",
          "label": "MAX",
          "detail": "linen · 230 °C (full send)",
          "steam": true
        }
      ]
    }
  },
  "chart": [
    {
      "clothing_type": "Whites (Core Deliverable)",
      "detergent": "Universal powder, full send — the bleach in powder is the real unlock that keeps whites from trending grey",
      "fabric_softener": "no",
      "temperature": "60",
      "spin": "1200",
      "duration": "~2:30",
      "program": "Cottons",
      "options": "Sustainability Flex",
      "ironing": "yes",
      "ironing_notes": "Align while slightly damp, steam on. Cotton can absorb all the heat you've got — no burnout risk here.",
      "iron_setting": "3",
      "drying": "Tumble dry normal, or line dry in the sun — free growth hack, sunlight bleaches whites at zero CAC.",
      "colour_group": "white",
      "mix_tags": "",
      "notes": "Wash whites solo — no cross-functional collaboration here. One stray coloured sock tanks the whole roadmap.",
      "reference_name": "",
      "reference_link": ""
    },
    {
      "clothing_type": "White Socks (Low Priority, High Volume)",
      "detergent": "Universal powder, full send",
      "fabric_softener": "no",
