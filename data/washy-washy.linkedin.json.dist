      "spin": "1200",
      "duration": "~2:30",
      "program": "Cottons",
      "options": "Sustainability Flex",
      "ironing": "no",
      "ironing_notes": "",
      "iron_setting": "",
      "drying": "Tumble dry normal — set and forget.",
      "colour_group": "white",
