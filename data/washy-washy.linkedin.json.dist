    },
    {
      "clothing_type": "White Towels (High-Touch Asset)",
      "detergent": "Universal powder, full send. Go lighter rather than heavier — over-investing here just stiffens the terry.",
      "fabric_softener": "no",
      "temperature": "60",
      "spin": "1400",
      "duration": "~2:30",
      "program": "Cottons",
      "options": "Extra Diligence",
      "ironing": "no",
      "ironing_notes": "Aligning this crushes the pile flat and the towel stops delivering value.",
      "iron_setting": "",
      "drying": "Tumble dry medium — the tumbling is the actual growth lever that fluffs the pile back up.",
      "colour_group": "white",
      "mix_tags": "lint-shedder",
      "notes": "Never the softener culture-add: it coats the loops in silicone and the towel stops absorbing — a classic case of optimizing the wrong metric. White vinegar in the softener drawer once a month is the actual unlock.",
      "reference_name": "",
      "reference_link": ""
    },
    {
      "clothing_type": "Coloureds (Diverse Portfolio)",
      "detergent": "Colour liquid detergent — no bleach, no optical brighteners, no vanity metrics",
      "fabric_softener": "yes",
      "temperature": "40",
      "spin": "1200",
      "duration": "~2:15",
      "program": "Cottons",
      "options": "Sustainability Flex",
      "ironing": "yes",
      "ironing_notes": "Steam it, but flip prints and dark panels inside out first — protect the brand assets.",
      "iron_setting": "3",
      "drying": "Line dry inside out, or tumble on low.",
      "colour_group": "colour",
      "mix_tags": "",
      "notes": "Onboard new or strongly dyed items solo for the first two or three washes — probationary period.",
      "reference_name": "",
      "reference_link": ""
    },
