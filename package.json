{
  "name": "washy-washy-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "wrangler deploy",
    "deploy:version": "wrangler versions upload",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "format": "prettier --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:md": "prettier --check \"**/*.md\" && markdownlint-cli2 \"**/*.md\"",
    "lint:prose": ".tools/vale --glob='!{styles/**,CHANGELOG.md}' --minAlertLevel=error .",
    "lint:prose:advice": ".tools/vale --glob='!{styles/**,CHANGELOG.md}' .",
    "lint:yaml": "prettier --check \"**/*.{yml,yaml}\"",
    "prepare": "lefthook install",
    "prose:sync": "bun run scripts/install-vale.ts && .tools/vale sync",
    "test": "bun test test/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@astrojs/react": "6.0.4",
    "@tailwindcss/vite": "4.3.3",
    "@washy-washy/core": "1.1.0",
    "@washy-washy/pdf": "1.0.0",
    "astro": "7.2.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.9",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "lefthook": "2.1.10",
    "markdownlint-cli2": "0.23.2",
    "pdf-lib": "1.17.1",
    "prettier": "3.9.6",
    "semantic-release": "25.0.9",
    "typescript": "6.0.3",
    "wrangler": "4.125.0"
  }
}
