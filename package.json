{
  "name": "washy-washy-web",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "check": "astro check",
    "deploy": "wrangler deploy",
    "deploy:version": "wrangler versions upload",
    "dev": "astro dev",
    "docs:media": "bun scripts/capture-docs-media.ts",
    "format": "prettier --write .",
    "lighthouse": "lhci autorun",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:md": "prettier --check \"**/*.md\" && markdownlint-cli2 \"**/*.md\"",
    "lint:package-json": "sort-package-json --check",
    "lint:prose": ".tools/vale --glob='!{styles/**,CHANGELOG.md}' --minAlertLevel=error .",
    "lint:prose:advice": ".tools/vale --glob='!{styles/**,CHANGELOG.md}' .",
    "lint:tailwind": "oxlint",
    "lint:yaml": "prettier --check \"**/*.{yml,yaml}\"",
    "mutation": "stryker run",
    "prepare": "lefthook install",
    "preview": "astro preview",
    "prose:sync": "bun run scripts/install-vale.ts && .tools/vale sync",
    "test": "bun --conditions=browser test test/",
    "test:e2e": "playwright test",
    "typecheck": "astro sync && tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "overrides": {
    "playwright-core": "1.63.0",
    "qs": "6.16.0",
    "smol-toml": "1.7.2"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.2",
    "@astrojs/svelte": "9.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@mcp-b/webmcp-polyfill": "5.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@washy-washy/core": "1.5.6",
    "@washy-washy/pdf": "2.4.1",
    "astro": "7.3.2",
    "svelte": "5.57.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@codecov/astro-plugin": "2.0.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@happy-dom/global-registrator": "20.14.5",
    "@hughescr/stryker-bun-runner": "1.4.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@shadcn/lint": "0.1.5",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@types/bun": "1.4.2",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "estree-walker": "3.0.3",
    "happy-dom": "20.14.5",
    "js-yaml": "4.3.2",
    "lefthook": "2.1.14",
    "markdownlint-cli2": "0.23.2",
    "oxlint": "1.85.0",
    "pdf-lib": "1.17.1",
    "prettier": "3.9.8",
    "semantic-release": "25.0.9",
    "sort-package-json": "4.0.0",
    "typescript": "6.0.3",
    "wrangler": "4.131.1"
  }
}
