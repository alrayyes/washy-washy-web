{
  "name": "washy-washy-web",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "check": "astro check",
    "deploy": "wrangler deploy",
    "deploy:version": "wrangler versions upload",
    "dev": "astro dev",
    "docs:media": "bun scripts/capture-docs-media.ts",
    "format": "prettier --write .",
    "lighthouse": "lhci autorun",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:md": "prettier --check \"**/*.md\" && markdownlint-cli2 \"**/*.md\"",
    "lint:package-json": "sort-package-json --check",
    "lint:prose": ".tools/vale --glob='!{styles/**,CHANGELOG.md,.claude/**}' --minAlertLevel=error .",
    "lint:prose:advice": ".tools/vale --glob='!{styles/**,CHANGELOG.md,.claude/**}' .",
    "lint:tailwind": "oxlint",
    "lint:yaml": "prettier --check \"**/*.{yml,yaml}\"",
    "mutation": "stryker run",
    "prepare": "lefthook install",
    "preview": "astro preview",
    "prose:sync": "bun run scripts/install-vale.ts && .tools/vale sync",
    "readme:shots": "bun scripts/capture-readme-shots.ts",
    "test": "bun --conditions=browser test test/",
    "test:e2e": "playwright test",
    "typecheck": "astro sync && tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "overrides": {
    "@react-pdf/renderer": "4.9.0",
    "basic-ftp": "6.2.1",
    "compression": "1.8.2",
    "handlebars": "4.7.10",
    "http-cache-semantics": "4.3.0",
    "katex": "0.18.2",
    "markdown-it": "14.3.2",
    "playwright-core": "1.64.0",
    "postcss-selector-parser": "7.1.6",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "sharp": "0.35.5",
    "smol-toml": "1.9.0",
    "source-map-js": "1.2.2",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.7",
    "@astrojs/svelte": "9.1.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@mcp-b/webmcp-polyfill": "6.0.3",
    "@tailwindcss/vite": "4.3.3",
    "@washy-washy/core": "1.6.3",
    "@washy-washy/pdf": "2.6.4",
    "astro": "7.4.2",
    "svelte": "5.57.2",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@codecov/astro-plugin": "2.0.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@happy-dom/global-registrator": "21.0.4",
    "@hughescr/stryker-bun-runner": "1.6.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@shadcn/lint": "0.2.3",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@types/bun": "1.4.4",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "estree-walker": "3.0.3",
    "happy-dom": "21.0.4",
    "js-yaml": "4.3.2",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0",
    "oxlint": "1.89.0",
    "pdf-lib": "1.17.1",
    "prettier": "3.9.10",
    "semantic-release": "25.0.9",
    "sort-package-json": "4.1.0",
    "typescript": "6.0.3",
    "wrangler": "4.152.0"
  }
}
