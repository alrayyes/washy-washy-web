{
  "name": "washy-washy-web",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "check": "astro check",
    "deploy": "wrangler deploy",
    "deploy:version": "wrangler versions upload",
    "dev": "astro dev",
    "docs:media": "bun scripts/capture-docs-media.ts",
    "format": "prettier --write .",
    "lighthouse": "lhci autorun",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:md": "prettier --check \"**/*.md\" && markdownlint-cli2 \"**/*.md\"",
    "lint:package-json": "sort-package-json --check",
    "lint:prose": ".tools/vale --glob='!{styles/**,CHANGELOG.md,.claude/**}' --minAlertLevel=error .",
    "lint:prose:advice": ".tools/vale --glob='!{styles/**,CHANGELOG.md,.claude/**}' .",
    "lint:tailwind": "oxlint",
    "lint:yaml": "prettier --check \"**/*.{yml,yaml}\"",
    "mutation": "stryker run",
    "prepare": "lefthook install",
    "preview": "astro preview",
    "prose:sync": "bun run scripts/install-vale.ts && .tools/vale sync",
    "readme:shots": "bun scripts/capture-readme-shots.ts",
    "test": "bun --conditions=browser test test/",
    "test:e2e": "playwright test",
    "typecheck": "astro sync && tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "overrides": {
    "@react-pdf/renderer": "4.9.0",
    "basic-ftp": "6.2.4",
    "compression": "1.8.2",
    "glob": "14.0.6",
    "http-cache-semantics": "4.3.0",
    "katex": "0.18.2",
    "markdown-it": "14.3.3",
    "minimatch": "11.0.8",
    "playwright-core": "1.64.0",
    "postcss-selector-parser": "7.1.6",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "re2js": "2.9.0",
    "sharp": "0.35.5",
    "smol-toml": "1.9.0",
    "source-map-js": "1.2.2",
    "uuid": "11.1.1",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@astrojs/starlight": "0.43.1",
    "@astrojs/svelte": "9.1.6",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@mcp-b/webmcp-polyfill": "6.2.0",
    "@tailwindcss/vite": "4.3.5",
    "@washy-washy/core": "1.6.4",
    "@washy-washy/pdf": "2.6.4",
    "astro": "7.4.13",
    "svelte": "5.57.3",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@codecov/astro-plugin": "2.0.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@happy-dom/global-registrator": "21.0.4",
    "@hughescr/stryker-bun-runner": "1.6.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@shadcn/lint": "0.2.5",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@types/bun": "1.4.5",
    "estree-walker": "3.0.3",
    "happy-dom": "21.0.4",
    "js-yaml": "4.3.2",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.2",
    "oxlint": "1.94.0",
    "pdf-lib": "1.17.1",
    "prettier": "3.10.1",
    "sort-package-json": "4.1.0",
    "typescript": "6.0.3",
    "wrangler": "4.165.0"
  }
}
