---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found | Washy washy"
  description="This page doesn't exist. Head back to the washing loads or the docs."
>
  <h1 class="mb-6 font-heading text-3xl font-bold text-ink sm:text-4xl">Page not found</h1>

  <div class="flex flex-col gap-4 text-base text-body">
    <p>
      There's nothing at this address. The link may be old, or the address mistyped.
    </p>
    <p>
      Go to the <a href="/">Home</a> page, or read the <a href="/docs/">Docs</a>.
    </p>
  </div>
</Layout>
