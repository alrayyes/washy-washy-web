---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** The config page's chart table needs real width to avoid scrolling every row. */
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL("/og-image.png", Astro.site);
const WIDTH = wide ? "max-w-[90rem]" : "max-w-3xl";
// The nav and footer stay at the widest page's width on every page — fixed
// regardless of `wide`, so switching between a narrow and a wide page never
// shifts the nav links sideways. Only <main>, whose content actually needs
// the room, varies.
const CHROME_WIDTH = "max-w-[90rem]";
const path = Astro.url.pathname;
const NAV_LINK = "rounded-md px-2 py-1 -mx-2 hover:bg-panel hover:text-accent";
const NAV_LINK_ACTIVE = "text-accent";
const NAV_LINK_INACTIVE = "text-body";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body class="bg-white text-body antialiased">
    <div class="gh-ribbon">
      <a href="https://github.com/alrayyes/washy-washy" target="_blank" rel="noopener noreferrer">
        Fork me on GitHub
      </a>
    </div>
    <nav
      class={`mx-auto flex ${CHROME_WIDTH} items-center gap-4 px-4 pt-6 text-sm font-semibold sm:px-6`}
      aria-label="Site"
    >
      <a
        href="/"
        aria-current={path === "/" ? "page" : undefined}
        class={`${NAV_LINK} ${path === "/" ? NAV_LINK_ACTIVE : NAV_LINK_INACTIVE}`}
      >
        Home
      </a>
      <a
        href="/config"
        aria-current={path.startsWith("/config") ? "page" : undefined}
        class={`${NAV_LINK} ${path.startsWith("/config") ? NAV_LINK_ACTIVE : NAV_LINK_INACTIVE}`}
      >
        Config
      </a>
    </nav>
    <main class={`mx-auto ${WIDTH} px-4 py-6 sm:px-6 sm:py-10`}>
      <slot />
    </main>
    <footer
      class={`mx-auto ${CHROME_WIDTH} space-y-2 border-t border-hairline px-4 pt-6 pb-10 text-sm text-muted sm:px-6`}
    >
      <p>
        <a
          href="https://github.com/alrayyes/washy-washy"
          class="underline decoration-hairline underline-offset-2 hover:text-accent hover:decoration-accent"
        >
          Washy washy on GitHub
        </a>
      </p>
      <p class="text-xs text-muted">
        {"© 2026 Ryan Kes. Licensed under the "}<a
          href="https://github.com/alrayyes/washy-washy/blob/main/LICENSE"
          class="underline decoration-hairline underline-offset-2 hover:text-accent hover:decoration-accent"
        >
          GPL-3.0-or-later
        </a>{
          " — provided as-is, with no warranty of any kind (see the licence, sections 15–16). Always check a garment's own care label; this chart reflects one household's settings, not a manufacturer's guarantee."
        }
      </p>
    </footer>
  </body>
</html>
