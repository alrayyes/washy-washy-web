---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import WarningBanner from "../components/WarningBanner";
import {
  absoluteLocaleUrl,
  DEFAULT_LOCALE,
  LOCALE_META,
  LOCALES,
  localeFromPath,
  pagePath,
  type TranslatedPage,
} from "../i18n/locales";
import { translator } from "../i18n/ui";
import { readUmamiConfig } from "../lib/analytics";
import { THEME_BOOTSTRAP_SCRIPT } from "../lib/themePreference";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** The config page's chart table needs real width to avoid scrolling every row. */
  wide?: boolean;
  /** Set on the three pages that exist per-locale (#143) — adds hreflang alternates. */
  translationKey?: TranslatedPage;
}

const { title, description, wide = false, translationKey } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL("/og-image.png", Astro.site);
const WIDTH = wide ? "max-w-[90rem]" : "max-w-3xl";
const umami = readUmamiConfig(import.meta.env);
const site = Astro.site ?? new URL(Astro.url.origin);
---

<!doctype html>
<html lang={LOCALE_META[locale].htmlLang}>
  <head>
    {
      translationKey && (
        <>
          {LOCALES.map((altLocale) => (
            <link
              rel="alternate"
              hreflang={LOCALE_META[altLocale].htmlLang}
              href={absoluteLocaleUrl(site, altLocale, pagePath(translationKey))}
            />
          ))}
          <link
            rel="alternate"
            hreflang="x-default"
            href={absoluteLocaleUrl(site, DEFAULT_LOCALE, pagePath(translationKey))}
          />
        </>
      )
    }
    {/* First thing in <head>, ahead of even <meta charset>, so a stored
    explicit light/dark choice applies before the browser paints anything
    — global.css's light-dark() values already resolve correctly off
    `color-scheme` alone for a first-time visitor (#62), this only matters
    for a returning one whose choice would otherwise flash the other mode
    for a frame (#111). is:inline keeps Astro from bundling/hashing it, so
    it stays exactly this — no import, no async fetch. */}
    <script is:inline set:html={THEME_BOOTSTRAP_SCRIPT} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {/* Belt-and-braces alongside global.css's `color-scheme: light dark`
    (#62) — declared in two places because the AC named both, and this
    one is readable before the stylesheet loads. */}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Opt-in only — absent unless both PUBLIC_UMAMI_SCRIPT_URL and
    PUBLIC_UMAMI_WEBSITE_ID are set at build time (analytics.ts). Umami
    itself is cookieless by default, so this needs no extra consent
    gating beyond that (#134). */}
    {
      umami && (
        <script is:inline defer src={umami.scriptUrl} data-website-id={umami.websiteId} />
      )
    }
  </head>
  <body class="bg-base text-body antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white focus:shadow-lg"
    >
      {t("skip.toContent")}
    </a>
    {
      locale !== DEFAULT_LOCALE && (
        <WarningBanner client:load message={t("banner.message")} dismissLabel={t("banner.dismiss")} />
      )
    }
    <div class="gh-ribbon">
      <a href="https://github.com/alrayyes/washy-washy" target="_blank" rel="noopener noreferrer">
        {t("ribbon.forkMe")}
      </a>
    </div>
    <SiteHeader />
    <main id="main" tabindex="-1" class={`mx-auto ${WIDTH} px-4 py-6 sm:px-6 sm:py-10`}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
