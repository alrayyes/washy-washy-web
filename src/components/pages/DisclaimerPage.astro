---
import { localeFromPath } from "../../i18n/locales";
import { translator } from "../../i18n/ui";
import Layout from "../../layouts/Layout.astro";

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
---

<Layout title={t("disclaimer.title")} description={t("disclaimer.description")} translationKey="disclaimer">
  <h1 class="mb-6 font-heading text-3xl font-bold text-ink sm:text-4xl">{t("disclaimer.h1")}</h1>

  <div class="flex flex-col gap-4 text-base text-body">
    <p>{t("disclaimer.p1")}</p>
    <p>{t("disclaimer.p2")}</p>
    <p>{t("disclaimer.p3")}</p>
    <p>{t("disclaimer.p4")}</p>
  </div>
</Layout>
