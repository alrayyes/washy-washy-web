---
// Same static import pattern as HomePage.astro — see that file's comment on
// why Vite's `?raw` import is used over a runtime file read.
import configSource from "../../../data/washy-washy.json.dist?raw";
import { localeFromPath } from "../../i18n/locales";
import { translator } from "../../i18n/ui";
import Layout from "../../layouts/Layout.astro";
import { buildChart } from "../../lib/chart";
import MachineEditor from "../MachineEditor";

const { items, machine } = buildChart(configSource);
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
---

<Layout
  title={t("page.machine.title")}
  description={t("page.machine.description")}
  translationKey="machine"
  wide
>
  <h1 class="mb-6 font-heading text-3xl font-bold text-ink sm:text-4xl">{t("page.machine.h1")}</h1>
  <MachineEditor client:load items={items} machine={machine} locale={locale} />
</Layout>
