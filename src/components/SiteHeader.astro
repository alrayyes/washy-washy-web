---
/**
 * The site's own header — extracted out of Layout.astro so a Starlight
 * override component (src/components/starlight/Header.astro) can render
 * the exact same header on /docs pages instead of Starlight's own (#114).
 * Self-contained: reads Astro.url.pathname itself rather than taking a
 * `path` prop, so both call sites stay trivial one-liners.
 */
import { docsHref, localeFromPath, matchTranslatedPage, relativeLocaleUrl } from "../i18n/locales";
import { translator } from "../i18n/ui";
import HeaderUpload from "./HeaderUpload.svelte";
import KeyboardNav from "./KeyboardNav.svelte";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.svelte";
import WebMcpBridge from "./WebMcpBridge.svelte";

const CHROME_WIDTH = "max-w-[90rem]";
const path = Astro.url.pathname;
const locale = localeFromPath(path);
const t = translator(locale);
const GITHUB_URL = "https://github.com/alrayyes/washy-washy";
const homeHref = relativeLocaleUrl(locale, "/");
const configHref = relativeLocaleUrl(locale, "/config");
const machineHref = relativeLocaleUrl(locale, "/config/machine");
const normalize = (value: string) => value.replace(/\/+$/, "") || "/";
const isHome = normalize(path) === normalize(homeHref);
const currentPage = matchTranslatedPage(path);
const isWashingLoads = currentPage === "config";
const isMachine = currentPage === "machine";
// /docs is routed by two different mechanisms (Starlight for six locales,
// hand-rolled routes for jive and linkedin — see locales.ts's DOCS_LOCALES)
// but the same "/xx/" prefix convention either way, so a plain
// prefix-stripped check works the same way for both.
const isDocs = path
  .replace(/^\/(ja|de|es|fr|ar|zh|tr|jive|linkedin)(?=\/|$)/, "")
  .startsWith("/docs");
const NAV_LINK =
  "flex min-h-11 items-center rounded-md px-2 -mx-2 hover:bg-panel hover:text-accent-text";
const NAV_LINK_ACTIVE = "text-accent-text";
const NAV_LINK_INACTIVE = "text-body";
---

<header
  id="site-header"
  class={`mx-auto flex ${CHROME_WIDTH} flex-wrap items-center gap-x-4 gap-y-2 border-b border-hairline px-4 py-2 sm:px-6 md:flex-nowrap`}
>
  <a href={homeHref} class="flex min-h-11 items-center gap-2 text-ink hover:text-accent-text">
    <Logo size={32} />
    <span class="font-heading text-xl font-bold tracking-tight sm:text-2xl">Washy washy</span>
  </a>
  {/* Below `md` this panel is closed behind the menu button and, when open,
  takes its own full-width row under the brand (`order-last w-full`), so a
  phone's first screen is the page, not seven header controls (#288). The
  script below the header closes it and wires the button; before that runs
  (or with JS off) the panel is simply open, so the nav is never lost. At
  `md` and up it is a plain inline row again, with `md:ml-auto`
  pushing it right and the ribbon clearance (`md:pr-32`, #46) on the
  controls after it. The ribbon itself is hidden below `md` (global.css),
  so the GitHub link lives in this panel there instead. */}
  <div
    id="site-menu"
    class="flex w-full flex-col gap-2 max-md:order-last max-md:data-[open=false]:hidden md:ml-auto md:w-auto md:flex-row md:items-center md:gap-3"
  >
    <nav class="flex flex-col text-sm font-semibold md:flex-row md:items-center md:gap-3" aria-label="Site">
      <a
        href={homeHref}
        aria-current={isHome ? "page" : undefined}
        class={`${NAV_LINK} ${isHome ? NAV_LINK_ACTIVE : NAV_LINK_INACTIVE}`}
      >
        {t("nav.home")}
      </a>
      <a
        href={configHref}
        aria-current={isWashingLoads ? "page" : undefined}
        class={`${NAV_LINK} ${isWashingLoads ? NAV_LINK_ACTIVE : NAV_LINK_INACTIVE}`}
      >
        {t("nav.washingLoads")}
      </a>
      <a
        href={machineHref}
        aria-current={isMachine ? "page" : undefined}
        class={`${NAV_LINK} ${isMachine ? NAV_LINK_ACTIVE : NAV_LINK_INACTIVE}`}
      >
        {t("nav.washerIron")}
      </a>
      <a
        href={docsHref(locale)}
        aria-current={isDocs ? "page" : undefined}
        class={`${NAV_LINK} ${isDocs ? NAV_LINK_ACTIVE : NAV_LINK_INACTIVE}`}
      >
        {t("nav.docs")}
      </a>
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        class={`${NAV_LINK} ${NAV_LINK_INACTIVE} md:hidden`}
      >
        {t("footer.github")}
      </a>
    </nav>
    <LanguageSwitcher />
    <HeaderUpload client:load locale={locale} />
    <KeyboardNav client:load locale={locale} />
  </div>
  <div class="ml-auto flex items-center gap-2 md:ml-0 md:pr-32">
    <ThemeToggle client:load locale={locale} />
    <button
      type="button"
      id="site-menu-button"
      aria-controls="site-menu"
      aria-expanded="true"
      class="inline-flex min-h-11 items-center justify-center gap-2 rounded-md border border-line bg-surface px-3 text-sm font-semibold text-ink shadow-sm hover:bg-panel focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 md:hidden"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
        <path stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      {t("nav.menu")}
    </button>
    <WebMcpBridge client:load locale={locale} />
  </div>
</header>
<script is:inline>
  (() => {
    const menu = document.getElementById("site-menu");
    const button = document.getElementById("site-menu-button");
    if (!menu || !button) return;
    const setOpen = (open) => {
      menu.dataset.open = String(open);
      button.setAttribute("aria-expanded", String(open));
    };
    setOpen(false);
    button.addEventListener("click", () => setOpen(menu.dataset.open !== "true"));
    menu.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || menu.dataset.open !== "true") return;
      setOpen(false);
      button.focus();
    });
  })();
</script>
