---
/**
 * Overrides Starlight's own page frame so /docs pages behave exactly like
 * the rest of the site: the header scrolls away with the page instead of
 * staying pinned, and the sidebar scrolls with the content at desktop
 * widths instead of staying fixed — full parity, not just matching
 * colours (#114). The default PageFrame keeps both header and sidebar
 * `position: fixed`, sized off a `--sl-nav-height` custom property; ours
 * removes that entirely rather than trying to fit our own (variable-
 * height, sometimes two-row) header into a fixed-height box.
 *
 * The mobile hamburger menu (`MobileMenuToggle`, `Sidebar`'s own content)
 * is untouched — reused verbatim from Starlight, still a full-screen
 * overlay when open, just anchored to the top of the viewport instead of
 * below a fixed header that no longer exists.
 *
 * Starlight 0.42 rebuilt that overlay on the native Popover API: the
 * toggle button is a plain `popovertarget="starlight__sidebar"` button
 * (no more `<starlight-menu-button>` custom element or `aria-expanded`),
 * and `#starlight__sidebar` itself has to carry the `popover` attribute
 * for the button to do anything — our own markup, not something Starlight
 * injects, since we render this div ourselves instead of reusing
 * Starlight's default `PageFrame`. Visibility on mobile now comes from
 * the browser's own popover show/hide (`display: none` until invoked)
 * rather than a `--sl-sidebar-visibility` custom property keyed off a
 * sibling's `aria-expanded`.
 */
import MobileMenuToggle from "virtual:starlight/components/MobileMenuToggle";
import SiteFooter from "../SiteFooter.astro";
import SiteHeader from "../SiteHeader.astro";

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="page">
  <SiteHeader />
  <div class="content-frame">
    {
      hasSidebar && (
        <nav
          class="sidebar print:hidden"
          aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}
        >
          <MobileMenuToggle />
          <div id="starlight__sidebar" class="sidebar-pane" popover="">
            <div class="sidebar-content sl-flex">
              <slot name="sidebar" />
            </div>
          </div>
        </nav>
      )
    }
    <div class="main-frame">
      <slot />
    </div>
  </div>
  <SiteFooter />
</div>

<style>
  @layer starlight.core {
    .page {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    .content-frame {
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    /* Mobile: the same full-screen toggle overlay Starlight ships, just
       anchored to the viewport's own top (`inset: 0`) rather than below a
       fixed header — there's no fixed header here to dodge. Shown/hidden
       state comes from the `popover` attribute itself (the UA hides it by
       default, the toggle button's `popovertarget` shows it) rather than
       anything we style here. */
    .sidebar-pane {
      /* The UA stylesheet applies its own opinionated popover styles
         (border, padding, positioning) — undo them rather than fight
         them with higher specificity. */
      margin: unset;
      border: unset;
      padding: unset;
      color: unset;

      position: fixed;
      z-index: var(--sl-z-index-menu);
      inset: 0;
      width: 100%;
      background-color: var(--sl-color-black);
      overflow-y: auto;
      scrollbar-gutter: stable;
    }

    .sidebar-content {
      height: 100%;
      min-height: max-content;
      padding: 1rem var(--sl-sidebar-pad-x) 0;
      flex-direction: column;
      gap: 1rem;
    }

    @media (min-width: 50rem) {
      .content-frame {
        flex-direction: row;
      }

      /* Desktop: always shown regardless of popover state (the toggle
         button itself is hidden here — Starlight's own `md:sl-hidden`),
         and back in normal flow, side-by-side with .main-frame — no more
         position: fixed, so it scrolls away with the rest of the page
         instead of staying pinned while a long doc scrolls under it. */
      .sidebar-pane {
        display: block;
        position: static;
        z-index: auto;
        inset: auto;
        width: var(--sl-sidebar-width);
        flex-shrink: 0;
        background-color: var(--sl-color-bg-sidebar);
        border-inline-end: 1px solid var(--sl-color-hairline-shade);
        overflow-y: visible;
      }

      .sidebar-content {
        height: auto;
      }

      .main-frame {
        flex: 1;
        min-width: 0;
      }
    }
  }
</style>
